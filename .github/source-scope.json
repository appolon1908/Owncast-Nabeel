    ".github/workflows/nabeel-integration-ci.yml": {
      "name": "NABEEL integration CI",
      "on": {
        "pull_request": {
          "branches": [
            "main"
          ]
        },
        "push": {
          "branches": [
            "pr/nabeel-*"
          ]
        }
      },
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "nabeel-integration": {
          "name": "nabeel-integration",
          "runs-on": [
            "self-hosted",
            "Linux",
            "X64",
            "codestra-ci",
            "nabeel-ci"
          ],
          "timeout-minutes": 10,
          "steps": [
            {
              "name": "Checkout exact source",
              "uses": "actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09",
              "with": {
                "persist-credentials": false
              }
            },
            {
              "name": "Validate",
              "shell": "bash",
              "run": "set -euo pipefail\ntest \"$(git rev-parse HEAD)\" = \"${GITHUB_SHA}\"\ntest -z \"$(git status --porcelain)\"\ntest -s docs/NABEEL_GOVERNANCE.md\ngrep -Fq \"https://github.com/ingtrader21-spec/Owncast-Nabeel.git\" docs/NABEEL_GOVERNANCE.md\ngrep -Fq \"https://github.com/owncast/owncast.git\" docs/NABEEL_GOVERNANCE.md\n"
            }
          ]
        }
      }
    },
    "governance/interim-release-policy.json": {
      "schema_version": 1,
      "policy_kind": "source_merge",
      "repository": "appolon1908/Owncast-Nabeel",
