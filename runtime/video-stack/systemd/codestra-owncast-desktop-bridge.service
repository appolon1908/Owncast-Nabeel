[Unit]
Description=Codestra Owncast desktop API bridge
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/codestra-owncast/desktop-bridge.env
ExecStart=/usr/bin/python3 /opt/codestra-owncast/desktop_bridge.py --host 10.0.0.73 --port 18180
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=10.0.0.220/32

[Install]
WantedBy=multi-user.target
