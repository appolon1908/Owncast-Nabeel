[Unit]
Description=Codestra Owncast server connector and webhook receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=videoctl
Group=videoctl
EnvironmentFile=/etc/codestra-video/owncast-connector.env
ExecStart=/usr/bin/python3 /opt/codestra-video/owncast-connector/server_connector.py --local-host 127.0.0.1 --local-port 18104 --webhook-host 10.0.0.220 --webhook-port 18184
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/codestra-video
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=10.0.0.73/32

[Install]
WantedBy=multi-user.target
